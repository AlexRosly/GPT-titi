{
  "name": "gpt-titi",
  "version": "1.0.0",
  "description": "The service for work with AI instruments",
  "main": "server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./server.js",
    "start:dev": "cross-env NODE_ENV=development nodemon ./server.js",
    "lint": "eslint **/*.js",
    "lint:fix": "eslint --fix **/*.js",
    "test": "node --test",
    "test:pinning": "node --test test/pinningRules.test.js",
    "test:token-transfers": "node --test test/tokenTransfers.test.js test/tokenTransfers.integration.test.js test/tokenTransfers.http.test.js test/legacyBilling.test.js",
    "db:indexes:token-transfers": "node scripts/createTokenTransferIndexes.js",
    "db:indexes:chat-v2": "node scripts/createChatV2Indexes.js",
    "test:reservations": "node --test --test-concurrency=1 test/chatDeliveryV2/reservations.integration.test.js test/chatDeliveryV2/transportRecovery.integration.test.js test/chatDeliveryV2/dod.integration.test.js",
    "test:chat-v2:integration": "node --test test/chatDeliveryV2/integration.test.js",
    "test:chat-v2:ws": "node --test test/chatDeliveryV2/ws.integration.test.js",
    "test:chat-v2:worker": "node --test test/chatDeliveryV2/worker.integration.test.js",
    "test:chat-v2:reliability": "node --test test/chatDeliveryV2/reliability.integration.test.js",
    "test:chat-v2:transport-recovery": "node --test test/chatDeliveryV2/transportRecovery.integration.test.js",
    "test:chat-v2:dod": "node --test test/chatDeliveryV2/dod.integration.test.js",
    "db:cleanup:chat-v2-tests": "node scripts/cleanupChatV2TestDbs.js",
    "db:indexes:token-ledger": "node scripts/createTokenLedgerIndexes.js",
    "test:balance-sync": "node --test test/balanceSync.integration.test.js test/tokenTransfers.http.test.js",
    "test:token-history": "node --test test/tokenHistoryQuery.test.js test/tokenHistory.integration.test.js",
    "db:indexes:files": "node scripts/createFileIndexes.js",
    "test:files": "node --test test/files/artifacts.test.js test/files/office.test.js test/files/textInput.test.js test/files/officeInput.test.js test/files/pdfInput.test.js test/files/ocrInput.test.js test/files/ocrInternational.test.js test/files/ocrLimits.test.js test/files/ocrQuality.test.js test/chatDeliveryV2.protocol.test.js test/chatDeliveryV2/historyDto.test.js test/chatDeliveryV2/acceptDuplicate.test.js test/files/ocrRead.test.js test/files/exactTranscription.test.js test/files/zip.test.js",
    "test:files:integration": "node scripts/testFilesIntegration.js",
    "ocr:file": "node scripts/checkOcrFile.js",
    "ocr:check": "node scripts/checkOcr.js",
    "test:web": "node --test test/web/reader.test.js test/web/budget.test.js test/web/context.test.js",
    "test:web:integration": "node scripts/testWebIntegration.js",
    "test:browser": "node --test test/browser/policy.test.js test/browser/agent.test.js test/browser/actions.test.js test/browser/session.test.js test/browser/logging.test.js",
    "test:browser:integration": "node scripts/testBrowserIntegration.js",
    "test:browser:smoke": "node --test test/browser/smoke.test.js",
    "browser:build": "docker build -t gptiti-browser:23 browser-worker",
    "test:zip": "node --test test/files/zip.test.js",
    "test:zip:integration": "node scripts/testZipIntegration.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexRosly/GPT-titi.git"
  },
  "author": "AlexRoslyi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AlexRosly/GPT-titi/issues"
  },
  "homepage": "https://github.com/AlexRosly/GPT-titi#readme",
  "devDependencies": {
    "eslint": "^9.39.1",
    "jszip": "3.10.1",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "docx": "9.5.1",
    "dotenv": "^17.2.3",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "google-auth-library": "^10.5.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.0.0",
    "mongoose": "^9.0.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "openai": "^6.15.0",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.17.2",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "sax": "1.6.1",
    "socket.io": "^4.8.3",
    "streamifier": "^0.1.1",
    "stripe": "^20.1.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "htmlparser2": "10.0.0",
    "ipaddr.js": "2.2.0",
    "iconv-lite": "0.6.3",
    "js-tiktoken": "1.0.21"
  }
}
