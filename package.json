{
  "name": "gpt-titi",
  "version": "1.0.0",
  "description": "The service for work with AI instruments",
  "main": "server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./app.js",
    "start:dev": "cross-env NODE_ENV=development nodemon ./app.js",
    "lint": "eslint **/*.js",
    "lint:fix": "eslint --fix **/*.js",
    "test": "node --test",
    "test:pinning": "node --test test/pinningRules.test.js",
    "db:indexes:chat-v2": "node scripts/createChatV2Indexes.js",
    "test:chat-v2:integration": "node --test test/chatDeliveryV2/integration.test.js",
    "test:chat-v2:ws": "node --test test/chatDeliveryV2/ws.integration.test.js",
    "test:chat-v2:worker": "node --test test/chatDeliveryV2/worker.integration.test.js",
    "test:chat-v2:reliability": "node --test test/chatDeliveryV2/reliability.integration.test.js",
    "test:chat-v2:transport-recovery": "node --test test/chatDeliveryV2/transportRecovery.integration.test.js",
    "test:chat-v2:dod": "node --test test/chatDeliveryV2/dod.integration.test.js",
    "db:cleanup:chat-v2-tests": "node scripts/cleanupChatV2TestDbs.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexRosly/GPT-titi.git"
  },
  "author": "AlexRoslyi",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AlexRosly/GPT-titi/issues"
  },
  "homepage": "https://github.com/AlexRosly/GPT-titi#readme",
  "devDependencies": {
    "eslint": "^9.39.1",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.0.0",
    "mongoose": "^9.0.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "openai": "^6.15.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "streamifier": "^0.1.1",
    "stripe": "^20.1.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  }
}
