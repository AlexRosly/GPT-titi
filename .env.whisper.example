# Configure the Node.js API to send transcription requests to Speaches.
WHISPER_BASE_URL=http://127.0.0.1:8000/v1
WHISPER_API_KEY=speaches-local
WHISPER_MODEL=Systran/faster-whisper-large-v3-turbo
WHISPER_TIMEOUT_MS=120000
TRANSCRIPTION_MAX_FILE_SIZE=26214400

# Optional Docker Compose setting (read from shell or project .env).
WHISPER_PORT=8000
